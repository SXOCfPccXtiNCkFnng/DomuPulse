# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta: só no servidor. Ignora o RLS, então nunca use em código de cliente.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública do app, usada nos links de e-mail
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push. Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@domutech.digital

# Segredo que o cron-job.org envia no cabeçalho Authorization (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Asaas
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token configurado no painel do Asaas ao cadastrar o webhook (mínimo 32 caracteres)
ASAAS_WEBHOOK_TOKEN=

# E-mail de boas-vindas (Resend). Sem estas variáveis o cadastro funciona,
# só não envia o e-mail.
RESEND_API_KEY=
EMAIL_FROM=Domu Pulse <contato@domutech.digital>

# E-mails da equipe DomuTech com acesso ao painel /interno, separados por
# vírgula. Também recebem os alertas de erro. Vazio = painel desligado.
PLATFORM_ADMIN_EMAILS=

# Captcha do Cloudflare (Turnstile) no cadastro, login e recuperação de senha.
# Vazio = captcha desligado. Crie em dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# NFS-e: emissão das notas dos corretores direto na API nacional (nfse.gov.br), sem custo.
# NFSE_ENV: "homologacao" para testar (notas sem valor fiscal) ou "producao".
# NFSE_CERT_KEY: chave que criptografa os certificados digitais dos corretores.
#   Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   Nunca troque depois de em uso: os certificados guardados deixariam de abrir.
NFSE_ENV=homologacao
NFSE_CERT_KEY=

# Evolution API (WhatsApp do módulo de RH). Self-host (ex.: Render).
# EVOLUTION_API_URL: a URL do servidor do Evolution.
# EVOLUTION_API_KEY: a AUTHENTICATION_API_KEY configurada no Evolution.
# EVOLUTION_WEBHOOK_TOKEN: segredo que vai no endereço do webhook (16+ caracteres).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=
# Opcional: endereço público que o Evolution chama (padrão: NEXT_PUBLIC_SITE_URL).
# Em dev, localhost não é alcançável: use a URL de produção ou de um túnel.
EVOLUTION_WEBHOOK_BASE_URL=

# IA do recrutamento (Google Gemini). Chave do Google AI Studio.
# GEMINI_MODEL opcional (padrão: gemini-2.5-flash).
GEMINI_API_KEY=
GEMINI_MODEL=
